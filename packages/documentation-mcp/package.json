{
  "name": "@davindermahal/documentation-mcp",
  "version": "0.5.1",
  "description": "MCP server that onboards a codebase for AI-agent-assisted development: scans the project, interviews the user, and maintains .ai/docs + .ai/context from an evidence archive",
  "license": "MIT",
  "type": "module",
  "bin": {
    "documentation-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davindermahal/ai-intake-documentation-mcp.git",
    "directory": "packages/documentation-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "smoke:confluence": "node --import tsx scripts/confluence-smoke-check.ts"
  },
  "dependencies": {
    "@davindermahal/confluence-client": "^0.1.0",
    "@davindermahal/context-schema": "^0.1.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
